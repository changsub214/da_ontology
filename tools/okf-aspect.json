{
  "annotations": {
    "description": "Open Knowledge Format v0.2 signal layer: type, provenance, trust, lifecycle, and computation contract.",
    "displayName": "OKF Signal"
  },
  "name": "okf",
  "recordFields": [
    {
      "annotations": {
        "description": "The OKF document type (e.g. 'Provision', 'Source Document').",
        "displayName": "OKF Type"
      },
      "index": 1,
      "name": "okf_type",
      "type": "string"
    },
    {
      "annotations": {
        "description": "How the current content was produced.",
        "displayName": "Generated"
      },
      "index": 2,
      "name": "generated",
      "recordFields": [
        {
          "annotations": {
            "description": "Actor that generated the document.",
            "displayName": "Generated By"
          },
          "index": 1,
          "name": "by",
          "type": "string"
        },
        {
          "annotations": {
            "description": "ISO 8601 timestamp of the content's last meaningful change.",
            "displayName": "Generated At"
          },
          "index": 2,
          "name": "at",
          "type": "datetime"
        }
      ],
      "type": "record"
    },
    {
      "annotations": {
        "description": "Materials the concept derives from, with credibility signals.",
        "displayName": "Sources"
      },
      "arrayItems": {
        "name": "source",
        "recordFields": [
          {
            "annotations": {
              "description": "Footnote identifier referenced from the body as [^id].",
              "displayName": "Source ID"
            },
            "index": 1,
            "name": "id",
            "type": "string"
          },
          {
            "annotations": {
              "description": "URI of the source, or a path to another concept in the bundle.",
              "displayName": "Resource"
            },
            "constraints": {
              "required": true
            },
            "index": 2,
            "name": "resource",
            "type": "string"
          },
          {
            "annotations": {
              "description": "Human-readable title of the source.",
              "displayName": "Title"
            },
            "index": 3,
            "name": "title",
            "type": "string"
          },
          {
            "annotations": {
              "description": "Actor responsible for the source.",
              "displayName": "Author"
            },
            "index": 4,
            "name": "author",
            "type": "string"
          },
          {
            "annotations": {
              "description": "How often the source was used over the usage window.",
              "displayName": "Usage Count"
            },
            "index": 5,
            "name": "usage_count",
            "type": "int"
          },
          {
            "annotations": {
              "description": "ISO 8601 timestamp of the source's own last change.",
              "displayName": "Last Modified"
            },
            "index": 6,
            "name": "last_modified",
            "type": "datetime"
          },
          {
            "annotations": {
              "description": "Source material classification (e.g. 'origin_document').",
              "displayName": "Kind"
            },
            "index": 7,
            "name": "kind",
            "type": "string"
          },
          {
            "annotations": {
              "description": "SHA-256 cryptographic digest of the source document.",
              "displayName": "SHA-256"
            },
            "index": 8,
            "name": "sha256",
            "type": "string"
          }
        ],
        "type": "record"
      },
      "index": 3,
      "name": "sources",
      "type": "array"
    },
    {
      "annotations": {
        "description": "Verification events. A 'human:' actor marks the highest trust tier.",
        "displayName": "Verified"
      },
      "arrayItems": {
        "name": "verification",
        "recordFields": [
          {
            "annotations": {
              "description": "Actor that confirmed the content.",
              "displayName": "Verified By"
            },
            "index": 1,
            "name": "by",
            "type": "string"
          },
          {
            "annotations": {
              "description": "ISO 8601 timestamp of the verification.",
              "displayName": "Verified At"
            },
            "index": 2,
            "name": "at",
            "type": "datetime"
          },
          {
            "annotations": {
              "description": "Verification methodology (e.g. 'source_text_match').",
              "displayName": "Verification Method"
            },
            "index": 3,
            "name": "method",
            "type": "string"
          },
          {
            "annotations": {
              "description": "Automated and manual verification checks passed.",
              "displayName": "Checks"
            },
            "index": 4,
            "name": "checks",
            "type": "string"
          }
        ],
        "type": "record"
      },
      "index": 4,
      "name": "verified",
      "type": "array"
    },
    {
      "annotations": {
        "description": "Lifecycle state: draft, stable, verified, or deprecated.",
        "displayName": "Status"
      },
      "index": 5,
      "name": "status",
      "type": "string"
    },
    {
      "annotations": {
        "description": "ISO 8601 timestamp on or after which the content is stale.",
        "displayName": "Stale After"
      },
      "index": 6,
      "name": "stale_after",
      "type": "datetime"
    },
    {
      "annotations": {
        "description": "Period the source usage counts were measured over.",
        "displayName": "Usage Window"
      },
      "index": 7,
      "name": "usage_window",
      "recordFields": [
        {
          "annotations": {
            "description": "ISO 8601 timestamp the window starts at.",
            "displayName": "From"
          },
          "index": 1,
          "name": "from",
          "type": "datetime"
        },
        {
          "annotations": {
            "description": "ISO 8601 timestamp the window ends at.",
            "displayName": "To"
          },
          "index": 2,
          "name": "to",
          "type": "datetime"
        }
      ],
      "type": "record"
    },
    {
      "annotations": {
        "description": "How an Attested Computation runs.",
        "displayName": "Runtime"
      },
      "index": 8,
      "name": "runtime",
      "type": "string"
    },
    {
      "annotations": {
        "description": "The typed, named holes a caller may fill.",
        "displayName": "Parameters"
      },
      "arrayItems": {
        "name": "parameter",
        "recordFields": [
          {
            "annotations": {
              "description": "Parameter name.",
              "displayName": "Name"
            },
            "index": 1,
            "name": "name",
            "type": "string"
          },
          {
            "annotations": {
              "description": "Parameter type.",
              "displayName": "Type"
            },
            "index": 2,
            "name": "type",
            "type": "string"
          },
          {
            "annotations": {
              "description": "Whether the caller must supply a value.",
              "displayName": "Required"
            },
            "index": 3,
            "name": "required",
            "type": "bool"
          }
        ],
        "type": "record"
      },
      "index": 9,
      "name": "parameters",
      "type": "array"
    },
    {
      "annotations": {
        "description": "Path to a file holding the computation.",
        "displayName": "Computation"
      },
      "index": 10,
      "name": "computation",
      "type": "string"
    },
    {
      "annotations": {
        "description": "How the computation is run and what evidence a run must return.",
        "displayName": "Executor"
      },
      "index": 11,
      "name": "executor",
      "recordFields": [
        {
          "annotations": {
            "description": "Run instructions or code a runner follows.",
            "displayName": "Resource"
          },
          "index": 1,
          "name": "resource",
          "type": "string"
        },
        {
          "annotations": {
            "description": "Fields a run must return as evidence.",
            "displayName": "Receipt Fields"
          },
          "arrayItems": {
            "name": "field",
            "type": "string"
          },
          "index": 2,
          "name": "receipt",
          "type": "array"
        }
      ],
      "type": "record"
    },
    {
      "annotations": {
        "description": "The consumer-side check that the sanctioned computation is what actually ran.",
        "displayName": "Attester"
      },
      "index": 12,
      "name": "attester",
      "recordFields": [
        {
          "annotations": {
            "description": "Deterministic code that takes a receipt and returns a verdict.",
            "displayName": "Resource"
          },
          "index": 1,
          "name": "resource",
          "type": "string"
        }
      ],
      "type": "record"
    },
    {
      "annotations": {
        "description": "Additional unstructured metadata if any.",
        "displayName": "Extra Frontmatter"
      },
      "index": 13,
      "name": "extra",
      "type": "string"
    },
    {
      "annotations": {
        "description": "Semantic version of the OKF entry (e.g. '0.2.0').",
        "displayName": "Version"
      },
      "index": 14,
      "name": "version",
      "type": "string"
    },
    {
      "annotations": {
        "description": "Credibility / provenance classification (authentic, guidance, internal_policy, synthetic).",
        "displayName": "Content Class"
      },
      "index": 15,
      "name": "content_class",
      "type": "string"
    },
    {
      "annotations": {
        "description": "How the source text was processed (e.g. 'verbatim_ko').",
        "displayName": "Treatment"
      },
      "index": 16,
      "name": "treatment",
      "type": "string"
    },
    {
      "annotations": {
        "description": "Primary natural language code (e.g. 'ko').",
        "displayName": "Language"
      },
      "index": 17,
      "name": "language",
      "type": "string"
    },
    {
      "annotations": {
        "description": "Copyright and usage license terms.",
        "displayName": "License"
      },
      "index": 18,
      "name": "license",
      "type": "string"
    },
    {
      "annotations": {
        "description": "Parent document entry path in the OKF bundle.",
        "displayName": "Part Of"
      },
      "index": 19,
      "name": "part_of",
      "type": "string"
    },
    {
      "annotations": {
        "description": "Article or section number in the source regulation.",
        "displayName": "Section Number"
      },
      "index": 20,
      "name": "section_number",
      "type": "string"
    },
    {
      "annotations": {
        "description": "Page number or span in the source PDF document.",
        "displayName": "Source Page"
      },
      "index": 21,
      "name": "source_page",
      "type": "string"
    },
    {
      "annotations": {
        "description": "Regulatory or organizational authority issuing the document.",
        "displayName": "Issuing Body"
      },
      "index": 22,
      "name": "issuing_body",
      "type": "string"
    },
    {
      "annotations": {
        "description": "Canonical document identifier in the asset registry.",
        "displayName": "Document ID"
      },
      "index": 23,
      "name": "document_id",
      "type": "string"
    },
    {
      "annotations": {
        "description": "Corpus category group (e.g. 'regulations', 'internal_policies').",
        "displayName": "Group"
      },
      "index": 24,
      "name": "group",
      "type": "string"
    },
    {
      "annotations": {
        "description": "Extraction pipeline strategy used to build the entry.",
        "displayName": "Extraction Strategy"
      },
      "index": 25,
      "name": "extraction_strategy",
      "type": "string"
    }
  ],
  "type": "record"
}